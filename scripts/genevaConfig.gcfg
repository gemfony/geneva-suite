################################################################################
#
# This file holds some configuration options used for the compilation
# of the Geneva library. Copy to your compilation directory and adapt
# as needed. Then configure Geneva with a command line similar to
# "/where/geneva/resides/scripts/prepareBuild.sh ./myGenevaConfig.gcfg"
# Follow the instructions given by the script.


# Where the cmake executable is located
CMAKE="/usr/bin/cmake"

# Compiler selection: 'clang', 'gcc', or '' (leave empty to let CMake choose).
# Default is 'clang'. Geneva is C++23 and requires GCC >= 15 or Clang >= 22.
COMPILER="clang"

#
# The Boost location parameters.
#
# NOTE: you need to either leave all three parameters empty, or set
# the parameter BOOSTROOT, or set both of BOOSTLIBS and BOOSTINCL.
#
# If you installed a binary Boost distribution you should first try
# leaving all three parameters undefined (commented out).
# If you installed Boost from source using a default installation tree,
# then it should be enough to set BOOSTROOT to the Boost installation prefix.
# If CMake is not able to find the Boost headers/libraries correctly,
# or these are installed at non-standard locations, then you should try
# to set BOOSTLIBS and BOOSTINCL. The folder BOOSTLIBS should be the
# location of the libboost_* libraries, and the folder BOOSTINCL should
# be the location of Boost's 'boost/' headers folder where the file
# 'version.hpp' is found.
#
BOOSTROOT="/opt/boost"
#BOOSTLIBS="/usr/lib"
#BOOSTINCL="/usr/include"

# Specify the root path of your MPI installation i.e. that among others contains the directories lib/ and bin/
# If empty, CMake searches for a default MPI installation that might not be the desired one if multiple installations exist
MPIROOT=""

# Build mode must be either 'Release', 'Debug', 'RelWithDebInfo',
# 'MinSizeRel' or 'Sanitize'. NOTE: the 'Sanitize' setting is experimental!
# It will default to 'Debug' on unsupported platforms; see
# http://googletesting.blogspot.ru/2014/06/threadsanitizer-slaughtering-data-races.html
BUILDMODE="Debug"

# Whether to build Geneva with testing code
BUILDTESTCODE="1"

# Whether to build Geneva with examples
BUILDEXAMPLES="1"

# Whether to build Geneva with benchmarks
BUILDBENCHMARKS="1"

# Whether compilation information should be emitted
VERBOSEMAKEFILE="0"

# Where the Geneva library shall go
INSTALLDIR="/opt/geneva"

# Further linker parameters you might want to provide
LINKEREXTRAFLAGS=""

# Whether to build the MPI consumer. It is built as a module of its own, libgemfony-geneva-mpi,
# next to libgemfony-geneva, and loaded at run time: the "mpi" consumer mnemonic exists when the
# module and an MPI library are present, and no other Geneva library or program links MPI, so
# Geneva programs also start on machines without MPI. A program using GMPISubClientOptimizer
# links the module directly.
BUILDMPICONSUMER="1"

# Whether to build the GPU consumer (GGPUConsumerT) into the courtier library and
# expose the "gpu" consumer mnemonic. It is an opt-in add-on: when enabled, courtier
# carries the CUDA backend (NVRTC linked; the CUDA driver loaded at run time, so a CUDA build
# starts on machines without a driver); when disabled, no GPU code is
# compiled and "gpu" is not a selectable consumer. Example 14 (GCUDAWorker) and the GPU
# optimisation benchmark are built only when this is enabled. Independent of USECUDARNG (a
# separate Hap feature). SKIPALLCUDA still forces the whole consumer off.
# Tri-state: "auto" (use a found CUDA toolkit, else off) | "on" (require CUDA, fail if absent)
# | "off" (never build it). Legacy "0"/"1" are still accepted.
BUILDGPUCONSUMER="auto"

# Whether to instrument the Common library and its tests with code-coverage
# flags (--coverage for GCC, -fprofile-instr-generate -fcoverage-mapping for
# Clang). Used together with the `coverage` make target to produce gcovr
# reports. Costs noticeable runtime; leave OFF for production builds.
WITHCOVERAGE="0"

# Build with a code sanitizer (developer diagnostics). One of:
#   none       (default) — no sanitizer, normal/production build
#   thread     — ThreadSanitizer: detects data races
#   address    — AddressSanitizer: detects memory errors (OOB, use-after-free)
#   undefined  — UndefinedBehaviorSanitizer
# When set to anything other than "none", CUDA and the MPI consumer are forced
# OFF automatically (nvcc cannot compile with -fsanitize; MPI floods TSan), and
# the whole C++ build is instrumented (much slower, for diagnostics only).
# See prompts/2026-05-30-sanitizer-rollout-plan.md.
SANITIZER="none"

# Set to 1 to skip all CUDA compilation entirely — no CUDA examples, no CUDA
# benchmark, and no CUDA RNG in Hap — even if nvcc is present on the system.
# All other CUDA settings (CUDA_NVCC, CUDA_ROOT, USECUDARNG) are ignored when
# this is 1.  Useful when the system CUDA is broken or incompatible.
SKIPALLCUDA="0"

# By default, CUDA-dependent code (CUDA examples/benchmark, the CUDA RNG backend and the GPU
# consumer) is only enabled when BOTH the CUDA toolkit AND the build host's GPU driver support the
# required CUDA version (>= 13.3). A new toolkit paired with an older driver compiles but fails at
# runtime in the NVRTC/PTX JIT, so that combination is auto-disabled (the rest of Geneva still builds,
# with a clear warning). Set FORCECUDA="1" to bypass the DRIVER check and build CUDA code whenever a
# new-enough toolkit is present, regardless of the build host's driver -- intended for build farms / CI
# where the machine that builds Geneva is not the machine that runs it. The toolkit-version
# requirement is NOT bypassed.
FORCECUDA="0"

# CUDA toolkit selection.
#
# MINIMUM SUPPORTED CUDA: 13.3.  Geneva is C++23, and 13.3 is the first toolkit
# whose host front end consumes the C++23 code base; CMake rejects an older
# toolkit (build without CUDA via SKIPALLCUDA=1 if you only have an older one).
#
# Leave both variables empty (the default) to let CMake auto-detect any
# installed CUDA (it must be >= 13.3).  Set CUDA_NVCC when you have multiple
# toolkits installed and want to pin a specific one.  CUDAToolkit_ROOT is
# derived automatically from CUDA_NVCC if left empty, so you usually only
# need to set the one path.
#
# Example — pin a specific >= 13.3 toolkit:
#   CUDA_NVCC="/usr/local/cuda-13.3/bin/nvcc"
#   CUDA_ROOT="/usr/local/cuda-13.3"   # optional; derived from CUDA_NVCC if omitted
#
# It configures and compiles the whole tree cleanly, including the Asio-using
# CUDA examples/benchmark (GCUDAWorker, GCUDAOptBenchmark).
#
# Historic note (Ubuntu 24.04 + glibc 2.39 only): an older 13.1's
# check_language(CUDA) failed because glibc 2.39 re-declared rsqrt with
# noexcept(true) (__THROW) after CUDA's crt/math_functions.h declared it
# without, and cudafe++ treated this as a hard error.  That glibc/rsqrt
# interaction does not occur on glibc 2.43+.
CUDA_NVCC=""
CUDA_ROOT=""

# Whether to add CUDA-generated random numbers to Hap.
# Note: enabling this makes the Hap library depend on the CUDA runtime, so
# programs linked with Geneva become less portable (CUDA toolkit required).
# CUDA examples and benchmarks are built automatically when nvcc is found,
# independently of this setting.
# Tri-state: "auto" (use a found CUDA toolkit, else the SIMD/CPU RNG engine) | "on"
# (require CUDA, fail if absent) | "off" (never use CUDA). Legacy "0"/"1" still accepted.
USECUDARNG="auto"

# Build example 14 (GCUDAWorker) with float parameters + a float GPU kernel instead of
# double. Only affects example 14. Default 1 (float): FP32 is ~14x faster than FP64 at the
# 1000-triangle workload on consumer GPUs (few FP64 units). Set to 0 for the double variant.
GIMAGE_USE_FLOAT="1"

# Selects the source the default Gem::Hap::GRandom proxy draws from (compile-time -- exactly one
# backend exists in a given build):
#   "queue"      -> the central factory package queue (the default; producers may bulk-fill via cuRAND/SIMD)
#   "local"      -> a per-proxy engine seeded by the factory (CPU-only, contention-free fallback)
#   "staged"     -> chunks from a shared, bulk-filled staging pool into a per-proxy double buffer
#   "quarantine" -> read in place from N rotating, bulk-filled pools (benign-race, aligned-64-bit)
# Other sources stay usable explicitly via GRandomT<randomSource::...>; this only sets the alias.
RANDOMSOURCE="queue"

# Further CMake parameters you might want to provide; these
# will be passed 'verbatim' to CMake's command line
CMAKEEXTRAFLAGS=""

# Further compiler parameters you might want to provide, for instance
# for turning on/off compiler warnings use "-Wextra -Wno-parentheses"
# See below for a number of "specialist flags" triggering different
# behaviour of the compiled Geneva library collection.
CXXEXTRAFLAGS=""

# "Specialist flags" available to fine-tune the behaviour of the Geneva library collection.
# Add to CXXEXTRAFLAGS in order to activate.
#
# -DGENEVA_HAP_RANDOM_FACTORY_DEFAULT_ARRAY_SIZE <unsigned integer>:
# The size of a single buffer produced by the random factory
# -DGENEVA_HAP_RANDOM_FACTORY_DEFAULT_BUFFER_SIZE <unsigned integer>:
# The default size of the thread-safe buffer used to store random number packages
# -DGENEVA_COMMON_DEFAULT_BUFFER_SIZE <unsigned integer>:
# The default size of a general thread-safe buffer
# -DGENEVA_HAP_RANDOM_FACTORY_DEFAULT_GET_WAIT <unsigned integer>:
# The maximum timed wait for get operations in the GRandomFactory random queue in milliseconds
# -DGENEVA_HAP_RANDOM_FACTORY_SEED_VECTOR_SIZE <unsigned integer>
# The size of the vector with seeds
