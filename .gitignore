/.idea
/.project
/.settings
/.cproject
.DS_Store
.com.apple.*
build/
cmake-build-*/
.vscode
CMakeUserPresets.json
# cmake-generated files that end up in the source tree on an in-source build
/CMakeDoxyfile.in
/CMakeDoxygenDefaults.cmake
/CPackConfig.cmake
/CPackSourceConfig.cmake
/DartConfiguration.tcl
/Doxyfile

# Stray dotfiles that appear when HOME is accidentally pointed at the repo root
/.bashrc
/.bash_profile
/.gitconfig
/.gitmodules
/.profile
/.ripgreprc
/.zshrc
/.zprofile

# Coverage / profiling artefacts. gcovr writes intermediate .gcov files into
# its working directory; if invoked from the source tree these land here.
*.gcov
*.gcda
*.gcno
*.profraw
*.profdata

# Local planning / prompt notes under prompts/ are scratch, not tracked.
/prompts/*
/prompts/obsolete/*
# Local assistant-guidance file, kept on disk but out of version control.
/CLAUDE.md
__pycache__/

# Local clangd configuration (points at a machine-specific build directory)
.clangd
