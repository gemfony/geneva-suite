# Doxygen configuration for the @GENEVA_DOC_LIB_NAME@ library.
#
# Minimal template -- only the keys that genuinely differ from Doxygen's
# defaults are set here. New Doxygen versions add and rename tags; by NOT
# enumerating every key we avoid the "obsolete tag" warnings that plagued
# the legacy top-level Doxyfile.in.
#
# Per-library values (PROJECT_NAME, INPUT, OUTPUT_DIRECTORY, GENERATE_TAGFILE,
# TAGFILES, ...) are substituted by CMake's configure_file from the
# corresponding <lib>/doc/CMakeLists.txt; everything below is shared across
# all four libraries.

PROJECT_NAME           = "Geneva -- @GENEVA_DOC_LIB_NAME@ library"
PROJECT_NUMBER         = "@GENEVA_VERSION_FULL@"
PROJECT_BRIEF          = "@GENEVA_DOC_LIB_DESC@"

# Sources to scan: the lib's own include/ and src/ trees.
INPUT                  = @CMAKE_SOURCE_DIR@/libs/@GENEVA_DOC_LIB_NAME@/include \
                         @CMAKE_SOURCE_DIR@/libs/@GENEVA_DOC_LIB_NAME@/src
FILE_PATTERNS          = *.cpp *.hpp *.cu
RECURSIVE              = YES

# Output stays in the build tree (one per-lib subdir under build/).
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Tag file emitted for this lib (consumed by downstream libs for cross-refs)
# and tag files consumed from upstream libs.
GENERATE_TAGFILE       = @CMAKE_CURRENT_BINARY_DIR@/@GENEVA_DOC_LIB_NAME@.tag
TAGFILES               = @GENEVA_DOC_TAGFILES@

# Extract every member by default (templates + private methods are valuable
# for understanding the implementation). Internal stays off to keep public
# docs uncluttered.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# Source-browsing + cross-references between symbols.
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

# Quiet console; only real doc-errors warn. Undocumented-parameter noise is
# silenced (Geneva is not fully Doxygenised; that is a separate effort).
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# C++20 / C++23 friendliness.
BUILTIN_STL_SUPPORT    = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# Dot-graph cap: default 50 truncates the "Included by" graphs for hot
# headers like geneva/GOptimizationEnums.hpp (61 includers) and
# geneva/ind/GOptimizableEntity.hpp. 200 covers the largest real graph
# in the codebase with headroom; not high enough to produce unreadable
# wall-of-spaghetti pictures.
DOT_GRAPH_MAX_NODES    = 200
